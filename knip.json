{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/scripts/*.mjs"],
      "project": ["tools/scripts/*.mjs"]
    },
    "packages/eslint-config": {
      "project": ["*.js"]
    },
    "packages/result": {},
    "packages/logger": {},
    "packages/ipc-contract": {},
    "packages/update-contract": {},
    "packages/updater-client": {},
    "apps/web-landing": {
      "project": ["src/**/*.{astro,ts}"]
    },
    "apps/desktop": {
      "entry": ["src/renderer/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "services/update-worker": {
      "project": ["src/**/*.ts"]
    },
    "tools/cli": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    // Se invoca desde .githooks/commit-msg (pnpm exec commitlint), no vía import.
    "@commitlint/cli",
    // `cloudflare:test` es un especificador de módulo virtual que expone
    // @cloudflare/vitest-pool-workers dentro del worker de test — knip lo
    // interpreta como el paquete npm "cloudflare", que no existe.
    "cloudflare"
  ]
}
