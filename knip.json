{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/scripts/*.mjs"],
      "project": ["tools/scripts/*.mjs"]
    },
    "packages/eslint-config": {
      "project": ["*.js"]
    },
    "packages/result": {},
    "packages/logger": {},
    "packages/ipc-contract": {},
    "apps/web-landing": {
      "project": ["src/**/*.{astro,ts}"]
    },
    "apps/desktop": {
      "entry": ["src/renderer/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreDependencies": [
    // Se invoca desde .githooks/commit-msg (pnpm exec commitlint), no vía import.
    "@commitlint/cli"
  ]
}
