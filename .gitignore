                    # Dependencias
node_modules/
.pnpm-store/

# Builds
dist/
dist-electron/
out/
release/
build/
.turbo/
.astro/
*.tsbuildinfo

# Binarios — NUNCA en git (el v1 tenía un .exe de 428 MB commiteado)
*.exe
*.dll
*.msi
*.asar
*.blockmap
*.7z
*.zip

# Entorno y secretos
.env
.env.*
!.env.example
.dev.vars
wrangler.toml.local

# Cloudflare Workers — generado por `wrangler types`, se regenera en cada test/typecheck
worker-configuration.d.ts
.wrangler/

# Tests y cobertura
coverage/
playwright-report/
test-results/
.tmp-tests/

# Base de datos local (vive de verdad en userData de Electron, no en el repo)
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite.bak

# Editores y SO
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
*.log

# Obsidian — docs/ es la vault. workspace*.json y el cache son locales por persona;
# app.json/appearance.json/core-plugins.json sí se versionan si se decide fijarlos.
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/plugins/*/data.json

# Claude Code — settings.json SÍ se versiona (los hooks son parte del proyecto)
.claude/settings.local.json
