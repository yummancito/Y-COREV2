# Config pública de updates (ADR-0006). Copiar a .env.local (gitignored) para
# probar el ciclo real de updates en dev. Sin este archivo la app queda
# inerte, que es el comportamiento correcto por defecto en desarrollo.
#
# Nunca apuntar aquí ni en .env.local al Worker de producción: usar un Worker
# de staging propio o `wrangler dev --local`. Un pnpm dev con la config de
# producción se convierte en un cliente real que contamina check_stats y
# consume cuota del free tier.

# URL base del Worker de staging/local, sin barra final.
YCORE_WORKER_URL=

# Secreto HMAC anti-scraping (ADR-0005 punto 6, no es seguridad real) — el
# mismo valor que se subió con `wrangler secret put YCORE_CLIENT_SECRET` en
# el Worker de staging.
YCORE_CLIENT_SECRET=

# Una o dos claves públicas Ed25519 (32 bytes raw, base64), separadas por
# coma si son dos — para verificar la firma del manifest (ADR-0005 punto 6).
YCORE_MANIFEST_PUBLIC_KEYS=
